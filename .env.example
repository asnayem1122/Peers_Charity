# PEER'S CHARITY - MASTER ENVIRONMENT CONFIGURATION EXAMPLE

# General Configuration
NODE_ENV=development

# Express Backend Config
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000
CORS_ORIGIN=http://localhost:3000

# Database (MongoDB)
MONGODB_URI=mongodb://127.0.0.1:27017/peers_charity

# Authentication (Better Auth)
BETTER_AUTH_SECRET=peers_charity_super_secret_key_32_characters_minimum_len
BETTER_AUTH_URL=http://localhost:5000

# Storage Provider (local | s3 | r2)
STORAGE_PROVIDER=local
STORAGE_BUCKET=peers-charity-local
STORAGE_REGION=auto
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
STORAGE_ENDPOINT=

# University Email Domain Whitelist (comma-separated)
UNIVERSITY_EMAIL_DOMAINS=@university.edu,@student.university.edu
